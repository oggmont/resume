            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="12" FCOLOR="White" CH="Senior Software Developer in Test"/>
                <para ALIGN="3" LINESP="19"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Capgemini - Wrocław, Poland."/>
                <para ALIGN="3" LINESP="19"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="REST API, UI Web and Kubernetes CRD testing."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="AWS/Azure Landing zone, Queues, Lambdas and microservices testing."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Test planning, design, implementation, execution, reporting and maintenance."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Technical leader of a team of 4+ testers under SAFe framework."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Java and python test automation lead."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Hackathon finalist. "/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Mentored tester trainees."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Technologies"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH=": Kyverno Chainsaw, jUnit, Rest Assured, Selenium, Maven, K8S."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Project Industry"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH=": Automotive, Financial."/>
                <para ALIGN="3" LINESP="15"/>
                <para ALIGN="3" LINESP="10"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="12" FCOLOR="White" CH="Quality Engineer"/>
                <para ALIGN="3" LINESP="19"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Lyft - Mexico City, México"/>
                <ITEXT FCOLOR="White" CH="."/>
                <para ALIGN="3" LINESP="19"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="iOS &amp; Android testing."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Quality processes for agile distributed team."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Test design and management for mobile features. "/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Technologies"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH=": Test Flight, Android Studio."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Project Industry"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH=": Transportation Mobility."/>
                <para ALIGN="3" LINESP="15"/>
                <para LINESP="10"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="12" FCOLOR="White" CH="Software QA Engineer"/>
                <para LINESP="19"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Wizeline - Guadalajara, México"/>
                <ITEXT FCOLOR="White" CH="."/>
                <para LINESP="19"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="JavaScript and Python test automation."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Back and front end web testing."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Test documentation creation."/>
                <para ALIGN="3" LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Leadership experience owning quality process and automation. "/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Onsite experience in Mexico, Thailand, Vietnam and Spain."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Part of tech interviewing team for QA positions."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Head of internal project to develop automation framework."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH="Instructor for Postman and JavaScript test frameworks courses."/>
                <para LINESP="15"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="9" FCOLOR="White" CH="Technologies"/>
                <ITEXT FONT="Helvetica Regular" FONTSIZE="9" FCOLOR="White" CH=": Testcafe, Robot Framework, Postman, Chai.js, Node.js, Express."/>
                <para ALIGN="0" LINESP="15"/>
