            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="12" FCOLOR="White" CH="ITESM"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="10" FCOLOR="White" CH="- Puebla, México"/>
                <para LINESP="19"/>
                <ITEXT FONT="Helvetica Bold" FONTSIZE="10" FCOLOR="White" CH="B.S. in Computer Science and Engineering."/>
                <para LINESP="19"/>
