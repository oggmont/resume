        <PAGEOBJECT XPOS="179.370708661417" YPOS="292.546771653543" OwnPage="0" ItemID="448779059" PTYPE="4" WIDTH="469.663937007874" HEIGHT="627.833241814359" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L469.664 0 L469.664 627.833 L0 627.833 L0 0 Z" copath="M0 0 L469.664 0 L469.664 627.833 L0 627.833 L0 0 Z" gXpos="179.370708661417" gYpos="292.546771653543" gWidth="0" gHeight="0" LAYER="5" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="16" CH="I’m a Software Engineer with more than six years of experience in testing. I have been involved in different web projects within the entertainment, e-commerce, financial, and automotive industries, owning quality processes and creating test planning, design, implementation, execution, and reporting."/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3" LINESP="18"/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="16" CH="I have created test automation frameworks for both frontend and backend using a variety of tools, mainly in JavaScript and Java, such as Selenium WebDriver, JUnit, TestCafé, and RestAssured. I also have the knowledge to apply manual approaches as an alternative for mobile and desktop app testing."/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3" LINESP="18"/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="16" CH="I’m familiar with setting up testing processes in cloud structures like landing zones, queues, lambdas, and microservices. I also have experience with testing frameworks for Kubernetes operators like Kyverno Chainsaw."/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3" LINESP="18"/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="16" CH="I hold a Technician Degree in Industrial Electromechanics and a B.S. in Computer Science and Engineering from the Monterrey Institute of Technology. I’m also an ISTQB Foundation Level certified tester."/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3" LINESP="18"/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="16" CH="I consider myself a strong engineer both individually and as a team member. I have worked onsite in multiple teams across Mexico, Thailand, Vietnam, Spain, and Poland. I have always found a way to adapt to new projects, contributing to quality teams and actively working on important code automation development with minimal guidance or mentoring, learning independently."/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3" LINESP="18"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT FONT="Helvetica Neue Regular" FONTSIZE="18" CH="Thanks for your consideration"/>
                <trail ALIGN="2"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="209.134488188976" YPOS="119.213858267717" OwnPage="0" ItemID="448631603" PTYPE="4" WIDTH="283.464566929134" HEIGHT="123.819810929166" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Name" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L283.465 0 L283.465 123.82 L0 123.82 L0 0 Z" copath="M0 0 L283.465 0 L283.465 123.82 L0 123.82 L0 0 Z" gXpos="209.134488188976" gYpos="119.213858267717" gWidth="0" gHeight="0" LAYER="6" NEXTITEM="-1" BACKITEM="-1">
