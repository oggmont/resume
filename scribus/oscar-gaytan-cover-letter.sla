                <DefaultStyle/>
                <ITEXT FONT="Avenir Black" FONTSIZE="42" FCOLOR="Blue_resume" CH="Oscar Gaytán Montero"/>
                <trail LINESP="60"/>
            </StoryText>
        </PAGEOBJECT>
