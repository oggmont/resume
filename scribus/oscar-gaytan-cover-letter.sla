        <PAGEOBJECT XPOS="509.60785884838" YPOS="227.994073881603" OwnPage="0" ItemID="448615219" PTYPE="4" WIDTH="177.815778579322" HEIGHT="33.8500498092129" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L177.816 0 L177.816 33.85 L0 33.85 L0 0 Z" copath="M0 0 L177.816 0 L177.816 33.85 L0 33.85 L0 0 Z" gXpos="509.60785884838" gYpos="227.994073881602" gWidth="0" gHeight="0" LAYER="4" NEXTITEM="-1" BACKITEM="-1">
